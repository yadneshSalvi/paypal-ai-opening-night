    "lucide-react": "0.468.0",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.2",
    "yauzl": "3.4.0",
    "zod": "4.6.7"

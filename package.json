{
  "name": "opening-night",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev --port 4105",
    "build": "next build",
    "start": "next start --port 4105",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/domain.test.ts tests/scheduling.test.ts tests/finance.test.ts tests/payments.test.ts tests/milestones.test.ts tests/commerce-resume.test.tsx tests/crew.test.ts tests/crew-storage.test.ts tests/crew-ui.test.tsx tests/crew-worker.test.ts tests/provider-lifetime.test.ts tests/intelligence.test.ts",
    "test:integration": "tsx --test tests/store.test.ts tests/bryntum.test.ts tests/payment-wire.test.ts tests/session-admission.test.ts tests/durable-work.test.ts tests/supplier-work.test.ts tests/wallet-work.test.ts tests/cohort-work.test.ts tests/remedy-work.test.ts tests/commerce-api.test.ts tests/rehearsals.test.ts tests/commerce-locks.test.ts tests/crew-api.test.ts tests/intelligence-store.test.ts",
    "worker:once": "tsx scripts/worker.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "verify:packages": "tsx scripts/verify-packages.ts",
    "test:intelligence": "tsx --test tests/intelligence.test.ts tests/intelligence-store.test.ts",
    "test:voice": "node --import ./scripts/qa/disabled-providers.mjs --import tsx --test tests/voice.test.ts tests/voice-store.test.ts",
    "test:sources": "node --import ./scripts/qa/disabled-providers.mjs --import tsx --test tests/sources.test.ts tests/sources-store.test.ts",
    "test:settlement": "node --import ./scripts/qa/disabled-providers.mjs --import tsx --test tests/settlement.test.ts tests/settlement-store.test.ts tests/settlement-recovery.test.ts",
    "test:payouts": "node --import ./scripts/qa/disabled-providers.mjs --import tsx --test tests/payouts.test.ts tests/payouts-store.test.ts",
    "test:wrap": "node --import ./scripts/qa/disabled-providers.mjs --import tsx --test tests/wrap.test.ts tests/wrap-store.test.ts tests/wrap-assistant-store.test.ts tests/provider-egress.test.ts",
    "qa:wrap:export": "node --import ./scripts/qa/disabled-providers.mjs --import tsx scripts/qa/wrap-export-qa.ts",
    "test:tour": "node --import ./scripts/qa/tour-disabled-providers.mjs --import tsx --test tests/tour-domain.test.ts tests/tour-store.test.ts tests/tour-recovery.test.ts tests/tour-client.test.tsx",
    "qa:tour:prepare": "node --import ./scripts/qa/tour-disabled-providers.mjs --import tsx scripts/qa/tour-prepare-native.ts",
    "qa:tour:http": "node --import ./scripts/qa/tour-disabled-providers.mjs --import tsx scripts/qa/tour-http-qa.ts",
    "qa:tour:serve": "node scripts/qa/tour-review-server.mjs"
  },
  "dependencies": {

# Required local runtime. Use Node22.x. Never commit actual credentials.
DATABASE_URL=postgresql://opening_night:replace_me@127.0.0.1:5432/opening_night
JUDGE_SESSION_SECRET=
AUTH_SECRET=
CRON_SECRET=
APP_BASE_URL=http://localhost:4105
BRYNTUM_LICENSE_KEY=

# Two DIFFERENT isolated US sandbox merchant apps.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_PROJECT_ISOLATED=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
OPENING_NIGHT_SUPPLIER_PAYPAL_CLIENT_ID=
OPENING_NIGHT_SUPPLIER_PAYPAL_CLIENT_SECRET=
OPENING_NIGHT_SUPPLIER_PAYPAL_EMAIL=
OPENING_NIGHT_SUPPLIER_PAYPAL_MERCHANT_ID=

# Private credentials for controlled browser approval, never browser code.
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
PAYPAL_SANDBOX_SELLER_EMAIL=
PAYPAL_SANDBOX_SELLER_PASSWORD=

# Registered IDs belong to the two different sandbox apps above.
# Configuration alone does not qualify authentic signed delivery.
PAYPAL_WEBHOOK_ID=
OPENING_NIGHT_SUPPLIER_PAYPAL_WEBHOOK_ID=

# Model integrations; a configured key is not execution evidence.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_PLANNER_MODEL=
OPENAI_REASONING_EFFORT=max
GEMINI_API_KEY=
GEMINI_MODEL=
BLOB_READ_WRITE_TOKEN=
